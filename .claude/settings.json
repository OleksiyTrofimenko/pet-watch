{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm build:shared)",
      "Bash(git status)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./apps/*/.env)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(git push*)"
    ]
  }
}
