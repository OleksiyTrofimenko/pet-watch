{
  "expo": {
    "name": "PetWatch",
    "slug": "petwatch",
    "scheme": "petwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petwatch.app"
    },
    "android": {
      "package": "com.petwatch.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PetWatch needs access to your photos so you can add a picture of your pet.",
          "cameraPermission": "PetWatch needs camera access so you can take a picture of your pet."
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "../../node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
              "../../node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
              "../../node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
              "../../node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
              "../../node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Newsreader",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ],
      "./plugins/with-scene-delegate"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
