// PetWatch data model.
//
// Key idea: "owner" and "watcher" are NOT user roles. Ownership is Pet.ownerId,
// watching is a row in PetWatcher. The same user can own one pet and watch another.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique // always stored lower-cased
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedPets           Pet[]
  watching            PetWatcher[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  receivedInvitations Invitation[]         @relation("InvitationInvitee")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  FISH
  REPTILE
  OTHER
}

model Pet {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  species   Species
  breed     String?
  ageYears  Int?     @map("age_years")
  notes     String?
  // S3 object key, never a URL. URLs are presigned on read so the bucket stays private.
  photoKey  String?  @map("photo_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  watchers    PetWatcher[]
  careTasks   CareTask[]
  invitations Invitation[]

  @@index([ownerId])
  @@map("pets")
}

// Join table = the watcher relationship itself. Deleting the row revokes access.
model PetWatcher {
  petId     String   @map("pet_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([petId, userId])
  @@index([userId]) // "which pets do I watch?"
  @@map("pet_watchers")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// One row per (pet, invitee). Re-inviting rotates the token on the same row
// instead of piling up duplicates — no partial unique index needed.
model Invitation {
  id         String           @id @default(uuid(7)) @db.Uuid
  petId      String           @map("pet_id") @db.Uuid
  inviterId  String           @map("inviter_id") @db.Uuid
  inviteeId  String           @map("invitee_id") @db.Uuid
  // SHA-256 of the token in the deep link. A DB leak does not leak usable links.
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  pet     Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([petId, inviteeId])
  @@map("invitations")
}

enum CareTaskType {
  FEEDING
  WALK
  MEDICATION
  PLAY
  GROOMING
  OTHER
}

enum Recurrence {
  DAILY
  WEEKLY
}

// A recurrence RULE, not an occurrence. "Feed at 08:00 daily" is one row.
// Today/Weekly views expand rules into occurrences (pure, unit-tested function).
model CareTask {
  id         String       @id @default(uuid(7)) @db.Uuid
  petId      String       @map("pet_id") @db.Uuid
  type       CareTaskType
  title      String
  notes      String?
  timeOfDay  Int          @map("time_of_day") // minutes since midnight, 0..1439
  recurrence Recurrence
  daysOfWeek Int[]        @default([]) @map("days_of_week") // 0=Sun..6=Sat; empty for DAILY
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, timeOfDay])
  @@map("care_tasks")
}

// Opaque refresh tokens, stored hashed, rotated on every use.
// Presenting an already-revoked token = likely theft -> revoke all of the user's tokens.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
