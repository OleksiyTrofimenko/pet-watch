# ---- Database (docker compose) ----
DATABASE_URL=postgresql://petwatch:petwatch@localhost:5433/petwatch?schema=public

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7

# ---- S3 (SeaweedFS locally) ----
S3_ENDPOINT=http://localhost:9000
# Host the *device* uses to reach SeaweedFS. On Android emulator use http://10.0.2.2:9000,
# on a physical device use your LAN IP, e.g. http://192.168.1.20:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=petwatch
S3_ACCESS_KEY=petwatch
S3_SECRET_KEY=petwatch-secret

# ---- Email (Mailpit locally: UI at http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="PetWatch <no-reply@petwatch.local>"

# ---- Links ----
APP_SCHEME=petwatch
PORT=3000
