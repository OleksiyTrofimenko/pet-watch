{
  "name": "petwatch",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @petwatch/api db:seed",
    "dev:api": "pnpm --filter @petwatch/api start:dev",
    "dev:mobile": "pnpm --filter @petwatch/mobile start",
    "build:shared": "pnpm --filter @petwatch/shared build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @petwatch/api test:e2e",
    "e2e:mobile": "sh apps/mobile/e2e/reset-android-media.sh && maestro test apps/mobile/e2e",
    "e2e:mobile:ios": "sh apps/mobile/e2e/prepare-ios-simulator.sh && maestro test --exclude-tags android-only apps/mobile/e2e",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
